# Copier en .env sur le serveur (jamais versionné) et compléter.

# Clé de signature des sessions — OBLIGATOIRE, 32 caractères minimum.
# Générer : python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# La changer déconnecte tout le monde.
TUTO_SECRET_KEY=

# Durée d'une session avant reconnexion, en heures (défaut : 168 = 7 jours).
TUTO_SESSION_HEURES=168

# Niveau de journalisation : DEBUG, INFO (défaut), WARNING, ERROR.
TUTO_LOG_LEVEL=INFO

# Proxys dont on accepte les en-têtes X-Forwarded-* (IP de l'utilisateur,
# https). « * » convient tant que le port 8000 n'est joignable que par Envoy ;
# sinon, mettre l'IP d'Envoy.
FORWARDED_ALLOW_IPS=*
